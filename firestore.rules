rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isModerator() {
      return signedIn() && (request.auth.token.admin == true ||
        request.auth.token.moderator == true);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private account documents: only the owner and trusted admins can read.
    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.isBanned == false;
      allow read: if isSelf(uid) || isAdmin();
      allow update: if (isSelf(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['username', 'avatar', 'status', 'bio', 'msgPrivacy',
              'showOnline', 'showLastSeen', 'readReceipts']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isBanned']));
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Global chat: signed-in members may read and post as themselves.
    match /globalMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 40;
      allow delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid || isModerator());
      allow update: if false;
    }

    // Friend requests are visible only to their sender and recipient.
    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid ||
         resource.data.to == request.auth.uid || isModerator());
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() &&
        (resource.data.from == request.auth.uid ||
         resource.data.to == request.auth.uid || isModerator());
    }

    // Friendship records are readable only by their two participants.
    match /friends/{friendId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Reports can be submitted by members; only moderators can inspect/manage.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isModerator();
    }

    // Chat documents and their messages require membership in the chat.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastUpdate']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if signedIn() &&
          (resource.data.senderId == request.auth.uid || isModerator());
      }
    }

    // Everything not explicitly listed above is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}